    speakerName: "\u5B66\u8005"
    text: "\u4F60\u73B0\u5728\u770B\u5230\u7684\u6BCF\u4E00\u4E2A\u5B57\uFF0C\u90FD\u6765\u81EA\u9010\u5B57\u663E\u793A\u7684\u6253\u5B57\u673A\u6548\u679C\u3002"
