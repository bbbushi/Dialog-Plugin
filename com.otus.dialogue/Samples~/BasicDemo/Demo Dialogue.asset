    speakerName: "\u65C5\u4EBA"
    text: "\u70B9\u51FB\u9F20\u6807\u5DE6\u952E\uFF0C\u6216\u8005\u6309\u4E0B\u7A7A\u683C\u952E\uFF0C\u5C31\u53EF\u4EE5\u7ACB\u523B\u663E\u793A\u5168\u90E8\u6587\u5B57\uFF0C\u6216\u8005\u63A8\u8FDB\u5230\u4E0B\u4E00\u53E5\u3002"
